# Copy to .env and fill in what you need: cp .env.example .env
# Every setting is optional; shell variables win over .env. CLI flags win over both.

# --- Translation ---------------------------------------------------------------
# Default translate driver (templates with `driver: env`): local | openai | claude
# DICH_ENGINE=local
# Local model (engine=local): vinai | opus
# DICH_LOCAL_MODEL=vinai

# OpenAI (engine=openai). Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Giá để log chi phí (USD / 1M token: vào,vào từ cache,ra), khi model không có trong bảng giá sẵn
# OPENAI_PRICE=0.25,0.025,2
# Any OpenAI-compatible endpoint (OpenRouter, LM Studio, Ollama...)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Claude Code CLI (engine=claude), uses your claude.ai login: sonnet | haiku | opus
# DICH_CLAUDE_MODEL=sonnet

# --- Dubbing -------------------------------------------------------------------
# Default preset voice, see `uv run dich voices`
# DICH_VOICE=Phạm Tuyên
# CPU threads for the voice model; 0 = performance cores on Apple Silicon (GPU/MPS measured 6x slower)
# DICH_TTS_THREADS=0
# Syllables per second the voice reads; LLM translation fits each sentence to its original time with it
# DICH_SPEECH_RATE=4.0

# --- Web UI (`dich serve`) -----------------------------------------------------
# Folder the UI may read and write
# DICH_UI_ROOT=~
# DICH_UI_PORT=7860

# --- Storage -------------------------------------------------------------------
# Local translation models (default: ./models)
# DICH_MODELS_DIR=./models
# Database, job workspaces (artifacts, logs), uploads, voice clips
# DICH_DATA_DIR=~/.local/share/dich-video
# TTS sentence cache
# DICH_CACHE_DIR=~/.cache/dich-video
# Days to keep the dubbed audio of earlier runs (to review or pick again); 0 = delete when a newer run is done
# DICH_KEEP_DAYS=7

# --- Workers (processes per lane) ----------------------------------------------
# cpu: local models (needle, ctranslate2, TTS, ffmpeg); net: OpenAI/Claude/downloads;
# interactive: voice previews; gpu: for GPU drivers
# (số worker mặc định mỗi lane; đổi trong trang Hàng đợi sẽ ghi đè và lưu ở <data>/workers.json)
# DICH_WORKERS_CPU=1
# DICH_WORKERS_NET=3
# DICH_WORKERS_INTERACTIVE=1
# DICH_WORKERS_GPU=0
