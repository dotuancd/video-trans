{
 "openapi": "3.1.0",
 "info": {
  "title": "dich",
  "version": "0.1.0"
 },
 "paths": {
  "/api/config": {
   "get": {
    "summary": "Get Config",
    "operationId": "get_config",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Config"
        }
       }
      }
     }
    }
   }
  },
  "/api/fs": {
   "get": {
    "summary": "List Dir",
    "operationId": "list_dir",
    "parameters": [
     {
      "name": "path",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "",
       "title": "Path"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Listing"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/jobs": {
   "get": {
    "summary": "List Jobs",
    "operationId": "list_jobs",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Job"
         },
         "type": "array",
         "title": "Response List Jobs"
        }
       }
      }
     }
    }
   },
   "post": {
    "summary": "Add Jobs",
    "operationId": "add_jobs",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/JobCreate"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/JobCreated"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/jobs/{job_id}": {
   "get": {
    "summary": "Get Job",
    "operationId": "get_job",
    "parameters": [
     {
      "name": "job_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Job Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Job"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "delete": {
    "summary": "Delete Job",
    "operationId": "delete_job",
    "parameters": [
     {
      "name": "job_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Job Id"
      }
     }
    ],
    "responses": {
     "204": {
      "description": "Successful Response"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/jobs/{job_id}/steps/{name}/run": {
   "post": {
    "summary": "Run Step",
    "operationId": "run_step",
    "parameters": [
     {
      "name": "job_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Job Id"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "enum": [
        "transcribe",
        "translate",
        "dub",
        "mux"
       ],
       "type": "string",
       "title": "Name"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/RunStep"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Job"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/jobs/{job_id}/steps/{name}/log": {
   "get": {
    "summary": "Get Step Log",
    "operationId": "get_step_log",
    "parameters": [
     {
      "name": "job_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Job Id"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "enum": [
        "transcribe",
        "translate",
        "dub",
        "mux"
       ],
       "type": "string",
       "title": "Name"
      }
     },
     {
      "name": "offset",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "default": 0,
       "title": "Offset"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StepLog"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/jobs/{job_id}/cancel": {
   "post": {
    "summary": "Cancel Job",
    "operationId": "cancel_job",
    "parameters": [
     {
      "name": "job_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Job Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Job"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/events": {
   "get": {
    "summary": "Events",
    "operationId": "events",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "text/event-stream": {}
      }
     }
    }
   }
  },
  "/api/subtitles": {
   "get": {
    "summary": "Get Subtitles",
    "description": "A .vi.srt with the original line of each cue next to it, or an original .srt alone.",
    "operationId": "get_subtitles",
    "parameters": [
     {
      "name": "path",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Path"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Subtitles"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "put": {
    "summary": "Save Subtitles",
    "description": "Rewrite the cues (texts, and timings when cues were merged or split), and the original .srt with\nthe same timings when every cue carries its `source`.",
    "operationId": "save_subtitles",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/SubtitlesSave"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SubtitlesSaved"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/subtitles/vtt": {
   "get": {
    "summary": "Subtitles Vtt",
    "operationId": "subtitles_vtt",
    "parameters": [
     {
      "name": "path",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Path"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "text/plain": {
        "schema": {
         "type": "string"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/uploads": {
   "put": {
    "summary": "Upload",
    "description": "The request body is the file. Each video gets a folder; upload its .srt / .vi.srt with the\nsame `id` so the steps find them next to it. Outputs are written in that folder too.",
    "operationId": "upload",
    "parameters": [
     {
      "name": "name",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Name"
      }
     },
     {
      "name": "id",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Uploaded"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "requestBody": {
     "content": {
      "application/octet-stream": {}
     }
    }
   }
  },
  "/api/media": {
   "get": {
    "summary": "Media",
    "operationId": "media",
    "parameters": [
     {
      "name": "path",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Path"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/reveal": {
   "post": {
    "summary": "Reveal",
    "description": "Show the file in Finder / the file manager.",
    "operationId": "reveal",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PathBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "204": {
      "description": "Successful Response"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/voices": {
   "get": {
    "summary": "List Voices",
    "operationId": "list_voices",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Voice"
         },
         "type": "array",
         "title": "Response List Voices"
        }
       }
      }
     }
    }
   }
  },
  "/api/voices/upload": {
   "post": {
    "summary": "Upload Voice",
    "description": "Keep a 3–8s clip to clone a voice from; returns its path for the dub step's ref_audio.",
    "operationId": "upload_voice",
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/Body_upload_voice"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PathBody"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/voices/preview": {
   "post": {
    "summary": "Preview Voice",
    "description": "Reads text (or a sentence of the subtitles) in the voice the dub step would use.\nThe text read is in the X-Preview-Text header, URL-encoded.",
    "operationId": "preview_voice",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Preview"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "audio/wav": {}
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Body_upload_voice": {
    "properties": {
     "file": {
      "type": "string",
      "contentMediaType": "application/octet-stream",
      "title": "File"
     }
    },
    "type": "object",
    "required": [
     "file"
    ],
    "title": "Body_upload_voice"
   },
   "Config": {
    "properties": {
     "root": {
      "type": "string",
      "title": "Root"
     },
     "defaults": {
      "additionalProperties": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "object",
      "title": "Defaults"
     }
    },
    "type": "object",
    "required": [
     "root",
     "defaults"
    ],
    "title": "Config"
   },
   "Cue": {
    "properties": {
     "index": {
      "type": "integer",
      "title": "Index"
     },
     "start": {
      "type": "number",
      "title": "Start"
     },
     "end": {
      "type": "number",
      "title": "End"
     },
     "source": {
      "type": "string",
      "title": "Source"
     },
     "text": {
      "type": "string",
      "title": "Text"
     }
    },
    "type": "object",
    "required": [
     "index",
     "start",
     "end",
     "source",
     "text"
    ],
    "title": "Cue"
   },
   "CueEdit": {
    "properties": {
     "start": {
      "type": "number",
      "title": "Start"
     },
     "end": {
      "type": "number",
      "title": "End"
     },
     "text": {
      "type": "string",
      "title": "Text"
     },
     "source": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source",
      "description": "the original line; given on every cue to rewrite the original .srt too"
     }
    },
    "type": "object",
    "required": [
     "start",
     "end",
     "text"
    ],
    "title": "CueEdit"
   },
   "Entry": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "path": {
      "type": "string",
      "title": "Path"
     },
     "dir": {
      "type": "boolean",
      "title": "Dir"
     },
     "kind": {
      "type": "string",
      "enum": [
       "dir",
       "media",
       "srt",
       "vi_srt",
       "dub",
       "audio",
       "other"
      ],
      "title": "Kind"
     }
    },
    "type": "object",
    "required": [
     "name",
     "path",
     "dir",
     "kind"
    ],
    "title": "Entry"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Job": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "source": {
      "type": "string",
      "title": "Source"
     },
     "start": {
      "type": "string",
      "enum": [
       "media",
       "srt",
       "vi_srt"
      ],
      "title": "Start"
     },
     "created_at": {
      "type": "number",
      "title": "Created At"
     },
     "status": {
      "type": "string",
      "enum": [
       "queued",
       "running",
       "done",
       "failed",
       "cancelled",
       "stale"
      ],
      "title": "Status"
     },
     "steps": {
      "items": {
       "$ref": "#/components/schemas/Step"
      },
      "type": "array",
      "title": "Steps"
     }
    },
    "type": "object",
    "required": [
     "id",
     "source",
     "start",
     "created_at",
     "status",
     "steps"
    ],
    "title": "Job"
   },
   "JobCreate": {
    "properties": {
     "path": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Path",
      "description": "a file or a folder of them; or give `paths`"
     },
     "paths": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Paths",
      "description": "files, each its own job with outputs next to it"
     },
     "start": {
      "type": "string",
      "enum": [
       "media",
       "srt",
       "vi_srt"
      ],
      "title": "Start",
      "default": "media"
     },
     "recursive": {
      "type": "boolean",
      "title": "Recursive",
      "default": false
     },
     "translate": {
      "type": "boolean",
      "title": "Translate",
      "default": true
     },
     "dub": {
      "type": "boolean",
      "title": "Dub",
      "default": false
     },
     "mux": {
      "type": "boolean",
      "title": "Mux",
      "default": false
     },
     "overwrite": {
      "type": "boolean",
      "title": "Overwrite",
      "default": false
     },
     "out": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Out"
     },
     "params": {
      "additionalProperties": true,
      "type": "object",
      "title": "Params",
      "description": "options of every step, see /api/config"
     }
    },
    "type": "object",
    "title": "JobCreate"
   },
   "JobCreated": {
    "properties": {
     "jobs": {
      "items": {
       "type": "integer"
      },
      "type": "array",
      "title": "Jobs"
     },
     "skipped": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Skipped"
     }
    },
    "type": "object",
    "required": [
     "jobs",
     "skipped"
    ],
    "title": "JobCreated"
   },
   "Listing": {
    "properties": {
     "path": {
      "type": "string",
      "title": "Path"
     },
     "parent": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Parent"
     },
     "entries": {
      "items": {
       "$ref": "#/components/schemas/Entry"
      },
      "type": "array",
      "title": "Entries"
     }
    },
    "type": "object",
    "required": [
     "path",
     "parent",
     "entries"
    ],
    "title": "Listing"
   },
   "PathBody": {
    "properties": {
     "path": {
      "type": "string",
      "title": "Path"
     }
    },
    "type": "object",
    "required": [
     "path"
    ],
    "title": "PathBody"
   },
   "Preview": {
    "properties": {
     "text": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Text",
      "description": "what to read; empty: a sentence of `subtitles`"
     },
     "voice": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Voice",
      "description": "preset name, or 'source' to clone the speaker of `media`"
     },
     "ref_audio": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Ref Audio"
     },
     "int8": {
      "type": "boolean",
      "title": "Int8",
      "default": false
     },
     "media": {
      "anyOf": [
       {
        "type": "string"
